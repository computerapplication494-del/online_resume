:root {
  --bg: #f3f5f4;
  --panel: #ffffff;
  --ink: #1d2b2a;
  --muted: #5d6e6c;
  --line: #d9e0de;
  --accent: #0f6b63;
  --accent-ink: #ffffff;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #121917;
    --panel: #1b2523;
    --ink: #e6eeec;
    --muted: #93a6a3;
    --line: #2f3d3a;
    --accent: #3cb5a8;
    --accent-ink: #0b1412;
    color-scheme: dark;
  }
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: "Segoe UI", system-ui, Arial, sans-serif;
  line-height: 1.5;
}

/* ---------- Top bar ---------- */
header.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 14px 20px;
  background: var(--panel);
  border-bottom: 1px solid var(--line);
}
header.top h1 { font-size: 1.1rem; margin: 0; }

.btn {
  background: var(--accent);
  color: var(--accent-ink);
  border: 0;
  border-radius: 6px;
  padding: 9px 16px;
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}
.btn.ghost {
  background: transparent;
  color: var(--ink);
  border: 1px solid var(--line);
}
.btn:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* ---------- Layout ---------- */
main {
  display: grid;
  grid-template-columns: minmax(300px, 440px) 1fr;
  gap: 20px;
  padding: 20px;
  max-width: 1300px;
  margin: 0 auto;
}
@media (max-width: 860px) {
  main { grid-template-columns: 1fr; }
}

/* ---------- Form ---------- */
form#editor {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 16px;
}
fieldset {
  border: 0;
  border-top: 1px solid var(--line);
  margin: 0;
  padding: 14px 0;
}
fieldset:first-of-type { border-top: 0; padding-top: 0; }
legend { font-weight: 700; padding: 0 0 8px; float: left; width: 100%; }
fieldset > * { clear: both; }

label { display: block; font-size: .85rem; color: var(--muted); margin: 8px 0 3px; }
input, textarea, select {
  width: 100%;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--bg);
  color: var(--ink);
  font: inherit;
}
textarea { min-height: 70px; resize: vertical; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.item {
  position: relative;
  border: 1px dashed var(--line);
  border-radius: 6px;
  padding: 10px;
  margin-top: 10px;
}
.item .rm {
  position: absolute;
  top: 6px;
  right: 6px;
  background: none;
  border: 0;
  color: var(--muted);
  font-size: 1.1rem;
  cursor: pointer;
}
.add { margin-top: 10px; }

/* ---------- Resume paper ---------- */
.preview-wrap { overflow-x: auto; }

#resume {
  background: #fff;
  color: #1a1a1a;
  width: 100%;
  max-width: 794px;
  min-height: 600px;
  margin: 0 auto;
  padding: 40px 44px;
  box-shadow: 0 2px 14px rgba(0, 0, 0, .12);
  font-family: "Segoe UI", Arial, sans-serif;
  font-size: 13.5px;
}
#resume h2 { font-size: 26px; margin: 0; }
#resume .title { color: var(--rc, #0f6b63); font-weight: 600; margin-top: 2px; }
#resume .contact {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 16px;
  margin-top: 8px;
  color: #444;
  font-size: 12.5px;
}
#resume h3 {
  font-size: 13px;
  letter-spacing: .05em;
  text-transform: uppercase;
  color: var(--rc, #0f6b63);
  border-bottom: 2px solid var(--rc, #0f6b63);
  padding-bottom: 3px;
  margin: 20px 0 8px;
}
#resume .entry { margin-bottom: 10px; }
#resume .entry-head { display: flex; justify-content: space-between; gap: 10px; font-weight: 600; }
#resume .entry-head span:last-child { font-weight: 400; color: #555; white-space: nowrap; }
#resume .sub { color: #555; }
#resume p { margin: 4px 0; }
#resume .skills { display: flex; flex-wrap: wrap; gap: 6px; }
#resume .skills span {
  border: 1px solid var(--rc, #0f6b63);
  color: var(--rc, #0f6b63);
  border-radius: 4px;
  padding: 1px 8px;
  font-size: 12.5px;
}
#resume .placeholder { color: #999; }

/* ---------- Print / Save as PDF ---------- */
@media print {
  body { background: #fff; }
  header.top, form#editor { display: none; }
  main { display: block; padding: 0; }
  #resume { box-shadow: none; max-width: none; padding: 0; }
  @page { margin: 14mm; }
}
